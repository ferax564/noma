{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["web/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
