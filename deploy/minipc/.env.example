# Copied to .env by install.sh (mode 600, never committed). Secrets that are
# files (access token, invitation code, sync token) live in ./secrets instead.

# Host port on 127.0.0.1. 8080, 8130, 8500 and 8501 are taken on the minipc.
NOMA_PUBLISH_PORT=8140
# HTTPS port that `tailscale serve` opens on the tailnet (443 and 8443 are taken).
NOMA_TAILSCALE_HTTPS_PORT=8444

# Set after the first registration: the owner's id from GET /api/users/me.
# Enterprise admin routes return 403 until this is set.
NOMA_CLOUD_ADMIN_USER_IDS=

# Optional: AI answers, agent drafts, and summaries (Claude Messages API).
# ANTHROPIC_API_KEY=
# NOMA_CLOUD_AI_USER_BUDGET_USD=10
# NOMA_CLOUD_AI_AGENT_BUDGET_USD=25

# Optional: /deploy and /test from Chat run on EZKeel.
# NOMA_CLOUD_EZKEEL_URL=https://app.ezkeel.com
# NOMA_CLOUD_EZKEEL_TOKEN_FILE=/run/noma/ezkeel-token
# NOMA_CLOUD_EZKEEL_APPS_DOMAIN=apps.ezkeel.com

# Wiki sync (sync.sh). Push the local sync branch to origin so wiki edits
# become pull requests; off by default.
# NOMA_DOGFOOD_PUSH=1
# NOMA_DOGFOOD_GIT_NAME=
# NOMA_DOGFOOD_GIT_EMAIL=
